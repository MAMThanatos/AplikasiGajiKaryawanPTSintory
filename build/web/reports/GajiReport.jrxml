	<style name="Detail" mode="Transparent" fontName="Times New Roman" pdfFontName="Times-Roman"/>
	<style name="Row" mode="Transparent" fontName="Times New Roman" pdfFontName="Times-Roman">
		<conditionalStyle>
			<conditionExpression><![CDATA[$V{REPORT_COUNT}%2 == 0]]></conditionExpression>
			<style mode="Opaque" backcolor="#F0EFEF"/>
		</conditionalStyle>
	</style>
	<parameter name="opsi" class="java.lang.String">
		<defaultValueExpression><![CDATA["Semua"]]></defaultValueExpression>
	</parameter>
	<parameter name="ktp" class="java.lang.String">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="ruang" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[0]]></defaultValueExpression>
	</parameter>
	<queryString language="SQL">
		<![CDATA[SELECT g.ktp, k.nama, k.ruang, g.kodepekerjaan, p.namapekerjaan, p.jumlahtugas AS tugas, g.gajibersih, g.gajikotor, g.tunjangan, 
       g.gajikotor AS gajipokok, 
       CASE 
           WHEN g.gajibersih > 4000000 THEN 'A'
           WHEN g.gajibersih > 3000000 THEN 'B'
           WHEN g.gajibersih > 2000000 THEN 'C'
           WHEN g.gajibersih > 1000000 THEN 'D'
           ELSE 'E'
       END AS huruf,
       CASE 
           WHEN g.gajibersih >= 3500000 THEN 'UMR'
           ELSE 'Tidak UMR'
       END AS status
FROM tbgaji g 
LEFT JOIN tbkaryawan k ON g.ktp = k.ktp 
LEFT JOIN tbpekerjaan p ON g.kodepekerjaan = p.kodepekerjaan
WHERE 
    ($P{opsi} = 'Semua')
    OR ($P{opsi} = 'KTP' AND g.ktp = $P{ktp})
    OR ($P{opsi} = 'ruang' AND k.ruang = $P{ruang})]]>
	</queryString>
	<field name="ktp" class="java.lang.String"/>
	<field name="nama" class="java.lang.String"/>
	<field name="ruang" class="java.lang.Integer"/>
	<field name="kodepekerjaan" class="java.lang.String"/>
	<field name="namapekerjaan" class="java.lang.String"/>
	<field name="tugas" class="java.lang.Integer"/>
	<field name="gajibersih" class="java.lang.Double"/>
	<field name="gajikotor" class="java.lang.Double"/>
	<field name="tunjangan" class="java.lang.Double"/>
	<field name="gajipokok" class="java.lang.Double"/>
	<field name="huruf" class="java.lang.String"/>
	<field name="status" class="java.lang.String"/>
